<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&family=Saira:wght@400;700&family=Saira+Extra+Condensed:wght@400;700&display=swap" rel="stylesheet">
    <script src="/js/script.js" defer></script> 
    <title>The finals calculator</title>
</head>
<body>
    <%- include('blocks/header') -%>
    <h1 class="main_title">Creat your own build...</h1>

    <section class="build">
        <button class="slot slot_class" data-type="class">Build</button>

        <ul class="build_slots build_main">
            <li><button class="slot" data-type="specialization">Spec.</button></li>
            <li><button class="slot" data-type="weapon">Weapon</button></li>
            <li><button class="slot" data-type="gadget">Gadget</button></li>
            <li><button class="slot" data-type="gadget">Gadget</button></li>
            <li><button class="slot" data-type="gadget">Gadget</button></li>
        </ul>

        <ul class="build_slots build_reserve">
            <li><button class="slot" data-type="reserve">Reserve</button></li>
            <li><button class="slot" data-type="reserve">Reserve</button></li>
            <li><button class="slot" data-type="reserve">Reserve</button></li>
            <li><button class="slot" data-type="reserve">Reserve</button></li>
        </ul>
    </section>
    
</body>
    
</html>
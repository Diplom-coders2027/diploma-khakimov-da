<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&family=Saira:wght@400;700&family=Saira+Extra+Condensed:wght@400;700&display=swap" rel="stylesheet">
    <script src="/js/script.js" defer></script>
    <title>Document</title>
</head>
<body>
    <%- include('blocks/header') -%>

    <h2 class="light_label"><%= light.class %></h2>
    <ul class = "light_weapons">
        <% light.weapons.forEach(w => { %>
            <li>
                <a href="/weapons/<%= w.name %>">
                    <img src="<%= w.image %>" alt="<%= w.name %>">
                </a>
            </li>
        <% }) %>
    </ul>
    </div>
</body>
</html>
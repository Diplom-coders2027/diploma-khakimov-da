<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&family=Saira:wght@400;700&family=Saira+Extra+Condensed:wght@400;700&display=swap" rel="stylesheet">
    <script src="/js/script.js" defer></script>
    <title>Document</title>
</head>
<body>
    <%- include('blocks/header') -%>
    <h2 class="class_label"><%= light.class %></h2>
    <% const excluded = ["Flashbang", "Frag Grenade", "Gas Grenade", "Goo Grenade", "Pyro Grenade", "Smoke Grenade"]; %>
    <% const exluded2 = ["Proximity Sensor","Explosive Mine"]; %>
    <ul class="class_weapons">
        <% light.gadgets.forEach(w => { %>
            <% if (!excluded.includes(w.name) && !w.name.includes("Sonar Grenade")) { %>
                <li class="weapon">
                    <a href="/gadgets/<%= encodeURIComponent(w.name) %>">
                        <img src="<%= w.image %>" alt="<%= w.name %>">
                        <span class="weapon_name"><%= w.name %></span>
                    </a>
                </li>
            <% } %>
        <% }) %>
    </ul>
    <h2 class="class_label"><%= heavy.class %></h2>
    <ul class="class_weapons">
        <% heavy.gadgets.forEach(w => { %>
            <% if (!excluded.includes(w.name) && !exluded2.includes(w.name)) { %>
                <li class="weapon">
                    <a href="/gadgets/<%= encodeURIComponent(w.name) %>">
                        <img src="<%= w.image %>" alt="<%= w.name %>">
                        <span class="weapon_name"><%= w.name %></span>
                    </a>
                </li>
            <% } %>
        <% }) %>
    </ul>
    <h2 class="class_label"><%= medium.class %></h2>
    <ul class="class_weapons">
        <% medium.gadgets.forEach(w => { %>
            <% if (!excluded.includes(w.name) && !exluded2.includes(w.name)) { %>
                <li class="weapon">
                    <a href="/gadgets/<%= encodeURIComponent(w.name) %>">
                        <img src="<%= w.image %>" alt="<%= w.name %>">
                        <span class="weapon_name"><%= w.name %></span>
                    </a>
                </li>
            <% } %>
        <% }) %>
    </ul>
    <h2 class="class_label">Medim & Heavy</h2>
    <ul class="class_weapons">
        <% medium.gadgets.forEach(w => { %>
            <% if (exluded2.includes(w.name)) { %>
                <li class="weapon">
                    <a href="/gadgets/<%= encodeURIComponent(w.name) %>">
                        <img src="<%= w.image %>" alt="<%= w.name %>">
                        <span class="weapon_name"><%= w.name %></span>
                    </a>
                </li>
            <% } %>
        <% }) %>
    </ul>
    <h2 class="class_label">Medim & Light</h2>
    <ul class="class_weapons">
        <% medium.gadgets.forEach(w => { %>
            <% if (w.name.includes("Sonar Grenade")) { %>
                <li class="weapon">
                    <a href="/gadgets/<%= encodeURIComponent(w.name) %>">
                        <img src="<%= w.image %>" alt="<%= w.name %>">
                        <span class="weapon_name"><%= w.name %></span>
                    </a>
                </li>
            <% } %>
        <% }) %>
    </ul>
    <h2 class="class_label">All Builds</h2>
    <ul class="class_weapons">
        <% medium.gadgets.forEach(w => { %>
            <% if (excluded.includes(w.name)) { %>
                <li class="weapon">
                    <a href="/gadgets/<%= encodeURIComponent(w.name) %>">
                        <img src="<%= w.image %>" alt="<%= w.name %>">
                        <span class="weapon_name"><%= w.name %></span>
                    </a>
                </li>
            <% } %>
        <% }) %>
    </ul>
</body>
</html>